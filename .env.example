# Server only. Generate with: openssl rand -hex 32
MEDIA_PROXY_SECRET=
# Exact, operator-reviewed CDN hostnames, comma-separated. No wildcards.
# Unknown hosts fail closed; inspect current manifests before adding a host.
MEDIA_ALLOWED_HOSTS=

# MyAnimeList OAuth (server only). Register a Web application on MAL.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:3000/api/auth/mal/callback
# Generate a separate key with: openssl rand -hex 32
MAL_TOKEN_ENCRYPTION_KEY=
# Persistent SQLite file. Requires Node 22.13+ and a persistent disk.
# Defaults to .data/sabame.sqlite; never commit the database or backups.
MAL_DATABASE_PATH=
