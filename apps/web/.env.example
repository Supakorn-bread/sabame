# Next.js frontend server configuration (copy to apps/web/.env.local).
# NestJS runs separately. Production requires the backend HTTPS origin.
BACKEND_URL=http://127.0.0.1:4000

# Playback remains in Next.js during the backend migration.
# Generate with: openssl rand -hex 32
MEDIA_PROXY_SECRET=
# Exact, operator-reviewed CDN hostnames; no wildcards.
MEDIA_ALLOWED_HOSTS=
# Optional metadata credential used by the existing playback resolver.
MAL_CLIENT_ID=

# Account/OAuth/database secrets belong in apps/api/.env instead.
# See apps/api/.env.example and docs/backend-migration.md.
