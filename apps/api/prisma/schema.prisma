generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        BigInt    @id
  profile   Json
  tokens    String
  expires   BigInt
  imported  Boolean   @default(false)
  revision  Int       @default(0)
  synced    DateTime? @db.Timestamptz(3)
  sessions  Session[]
  entries   Entry[]
  operations Operation[]

  @@map("accounts")
}

model Session {
  hash    String  @id
  userId  BigInt  @map("user_id")
  expires BigInt
  account Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
  @@map("sessions")
}

model OAuthTransaction {
  hash      String @id
  stateHash String @map("state_hash")
  verifier  String
  expires   BigInt

  @@index([expires])
  @@map("oauth")
}

model Entry {
  userId  BigInt @map("user_id")
  animeId String @map("anime_id")
  payload Json
  account Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, animeId])
  @@map("entries")
}

model Operation {
  userId  BigInt @map("user_id")
  id      String
  animeId String @map("anime_id")
  payload Json
  account Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, animeId])
  @@map("operations")
}

model Lease {
  userId  BigInt @id @map("user_id")
  owner   String
  expires BigInt

  @@map("leases")
}
