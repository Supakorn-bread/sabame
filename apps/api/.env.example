# NestJS backend only. Copy to apps/api/.env for local development.
APP_ORIGIN=http://localhost:3000
PORT=4000
# Local Compose database. Production DATABASE_URL uses Neon pooled connection.
DATABASE_URL=postgresql://sabame:sabame_local@127.0.0.1:55432/sabame_dev
# Direct (unpooled) connection for explicit Prisma migrations only.
DIRECT_URL=postgresql://sabame:sabame_local@127.0.0.1:55432/sabame_dev
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:3000/api/auth/mal/callback
# Generate a separate stable key with: openssl rand -hex 32
MAL_TOKEN_ENCRYPTION_KEY=
ANIMESCHEDULE_API_TOKEN=

# Tests accept only a dedicated local database named sabame_test.
TEST_DATABASE_URL=postgresql://sabame:sabame_local@127.0.0.1:55432/sabame_test
